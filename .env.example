# Copy to .env and fill in. Never commit .env.

# Soniox real-time speech-to-text — key: https://console.soniox.com
SONIOX_API_KEY=
# us (default), eu, jp or in — must match the region of the key's project
# SONIOX_REGION=us
# SONIOX_MODEL=stt-rt-v5

# Send each finalized, labelled block to: sheets, platform, or both (sheets,platform).
SEND_TARGET=sheets
# Google Sheets: keep the service account JSON outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=

# Aletheia platform (optional: set SEND_TARGET=platform to send drafts instead)
# Base URL of the platform, e.g. http://localhost:3000 for a local instance
ALETHEIA_URL=
# Ory project URL used by that platform (its ORY_SDK_URL)
ORY_URL=
# contentId of the debate (not the claim id in the page URL)
ALETHEIA_DEBATE_ID=
ALETHEIA_PERSONALITY_LULA=
ALETHEIA_PERSONALITY_FLAVIO=
# ALETHEIA_EMAIL=you@example.org
# Must be different on each machine
# ALETHEIA_MACHINE=operator1
# Also send each block's checkability score (0-100) with the turn. Leave off
# until the platform accepts the "checkability" field, or every send may fail.
# ALETHEIA_SEND_CHECKABILITY=1

# Checkability scoring with Jev (python3 checkability.py, see CHECKABILITY.md)
# your_typesafe_api_key_here returns random mock answers; empty is an error
TYPESAFE_API_KEY=your_typesafe_api_key_here
# Pinned so scores are reproducible; stored with every score
JEV_MODEL=jev-1.13.0
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_TIMEOUT=30
# Seconds between retries on 408/429/5xx/timeouts
# JEV_BACKOFF_SECONDS=2,5,10
