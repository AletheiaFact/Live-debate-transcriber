# Copy to .env and fill in. Never commit .env.

# Soniox real-time speech-to-text — key: https://console.soniox.com
SONIOX_API_KEY=
# us (default), eu, jp or in — must match the region of the key's project
# SONIOX_REGION=us
# SONIOX_MODEL=stt-rt-v5

# Send each finalized, labelled block to: sheets, platform, or both (sheets,platform).
SEND_TARGET=sheets
# Google Sheets: keep the service account JSON outside this repository.
GOOGLE_APPLICATION_CREDENTIALS=
SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=

# Optional AI-assisted evidence retrieval (never writes to this evidence workbook).
AI_EVIDENCE_ENABLED=false
AI_EVIDENCE_PROVIDER=ollama
AI_EVIDENCE_OLLAMA_BASE_URL=http://192.168.0.180:11434/v1
# Available on the development server when checked; run python ai_evidence.py --check.
AI_EVIDENCE_OLLAMA_MODEL=qwen3.5:4b
# Disable model thinking for live latency; leave blank if unsupported by your server.
AI_EVIDENCE_OLLAMA_REASONING_EFFORT=none
AI_EVIDENCE_OPENAI_BASE_URL=https://api.openai.com/v1
AI_EVIDENCE_OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
AI_EVIDENCE_SPREADSHEET_ID=1rY0NKhb_n2meBSTfAYFXEsUoJaxZku31XZMs-qVNc3k
AI_EVIDENCE_JSON_MODE=json_schema
# Automatically omitted for OpenAI GPT-5+ and o-series reasoning models.
# Leave blank to omit for other models/providers that reject custom temperature.
AI_EVIDENCE_TEMPERATURE=0
AI_EVIDENCE_MAX_CANDIDATES=10
AI_EVIDENCE_CACHE_TTL_SECONDS=300
AI_EVIDENCE_TIMEOUT_SECONDS=90
# Advanced: search all four tabs; optional per-kind column weights and topic routing.
# AI_EVIDENCE_WEIGHTS={"tracking":{"L":5,"G":4,"F":3,"T":3,"N":1}}
# AI_EVIDENCE_TOPIC_TEAMS={"saúde":["F2","L1"]}

# Aletheia platform (optional: set SEND_TARGET=platform to send drafts instead)
# Base URL of the platform, e.g. http://localhost:3000 for a local instance
ALETHEIA_URL=
# Ory project URL used by that platform (its ORY_SDK_URL)
ORY_URL=
# contentId of the debate (not the claim id in the page URL)
ALETHEIA_DEBATE_ID=
ALETHEIA_PERSONALITY_LULA=
ALETHEIA_PERSONALITY_FLAVIO=
# ALETHEIA_EMAIL=you@example.org
# Must be different on each machine
# ALETHEIA_MACHINE=operator1

# Checkability scoring with Jev (python3 checkability.py, see CHECKABILITY.md)
# your_typesafe_api_key_here returns random mock answers; empty is an error
TYPESAFE_API_KEY=your_typesafe_api_key_here
# Pinned so scores are reproducible; stored with every score
JEV_MODEL=jev-1.13.0
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_TIMEOUT=30
# Seconds between retries on 408/429/5xx/timeouts
# JEV_BACKOFF_SECONDS=2,5,10
